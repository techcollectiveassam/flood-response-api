meta {
  name: Send SOS
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/sos
  body: json
  auth: none
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setEnvVar("sosTrackingId", res.getBody().data.tracking_id);
  }
}

body:json {
  {
    "disaster_ref_id": "{{disasterRefId}}",
    "reporter_mobile": "0000000000",
    "message": "Water level rising rapidly",
    "location": {
      "latitude": 26.29,
      "longitude": 91.8
    }
  }
}