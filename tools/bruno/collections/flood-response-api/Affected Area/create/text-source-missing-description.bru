meta {
  name: Create affected area - text source missing description
  type: http
  seq: 17
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Silchar water logging",
    "location": {
      "source": "text"
    },
    "severity": "low"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_location
}

tests {
  test("text source without description is rejected", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'invalid_location');
    expect(err).to.have.property('message', 'description is required for text source');
  });
}