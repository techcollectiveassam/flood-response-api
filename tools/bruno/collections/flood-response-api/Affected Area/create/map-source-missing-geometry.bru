meta {
  name: Create affected area - map source missing geometry
  type: http
  seq: 18
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Majuli island flood belt",
    "location": {
      "source": "map"
    },
    "severity": "critical"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_location
}

tests {
  test("map source without geometry is rejected", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'invalid_location');
    expect(err).to.have.property('message', 'geometry is required for map source');
  });
}