meta {
  name: Create affected area - valid gps
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Dhemaji river bank",
    "description": "Flooded river bank area",
    "location": {
      "source": "gps",
      "name": "Dhemaji river bank",
      "latitude": 26.2,
      "longitude": 91.8
    },
    "severity": "high",
    "reporter": {
      "name": "Rakesh",
      "mobile": "0000000000"
    }
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

tests {
  test("create returns the affected area and report", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('affected_area');
    expect(data).to.have.property('report');
    expect(data).to.have.property('is_new_area', true);
    expect(data).to.have.property('confidence', 0);
    expect(data).to.have.property('match_reason', 'none');
  
    const area = data.affected_area;
    expect(area).to.have.property('id');
    expect(area).to.have.property('name', 'Dhemaji river bank');
    expect(area).to.have.property('severity', 'high');
    expect(area).to.have.property('verification_status');
    expect(area).to.have.property('report_count');
    expect(area.latitude).to.equal(26.2);
    expect(area.longitude).to.equal(91.8);
  
    expect(data.report).to.have.property('id');
    expect(data.report).to.have.property('area_id', area.id);
    expect(data.report.reporter).to.eql({ name: 'Rakesh', mobile: '0000000000' });
  });
  
  test("captures the new affected area id", function() {
    const data = res.getBody().data;
    bru.setEnvVar("affectedAreaId", data.affected_area.id);
  });
}
