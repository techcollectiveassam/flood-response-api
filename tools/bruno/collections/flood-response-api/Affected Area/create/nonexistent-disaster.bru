meta {
  name: Create affected area - nonexistent disaster
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": 999999,
    "name": "Unknown disaster area",
    "location": {
      "source": "gps",
      "latitude": 26.2,
      "longitude": 91.8
    },
    "severity": "medium"
  }
}

assert {
  res.status: eq 404
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq disaster_not_found
}

tests {
  test("unknown disaster id returns a 404", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'disaster_not_found');
    expect(err).to.have.property('message');
  });
}