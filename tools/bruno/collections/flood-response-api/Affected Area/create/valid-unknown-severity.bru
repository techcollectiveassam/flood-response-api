meta {
  name: Create affected area - unknown severity
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_ref_id": "{{disasterRefId}}",
    "location": {
      "source": "text",
      "description": "Severity not yet assessed"
    },
    "severity": "unknown"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("unknown severity is accepted", function() {
    const data = res.getBody().data;
    const area = data.affected_area;
    expect(area).to.have.property('ref_id');
    expect(area).to.have.property('severity', 'unknown');
    expect(data).to.have.property('is_new_area', true);
    expect(data).to.have.property('match_reason', 'unmatchable');
  });
}
