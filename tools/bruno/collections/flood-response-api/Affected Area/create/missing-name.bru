meta {
  name: Create affected area - missing name
  type: http
  seq: 5
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "location": {
      "source": "gps",
      "latitude": 26.1,
      "longitude": 91.5
    },
    "severity": "medium"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_request_body
}

tests {
  test("missing name is reported as validation error", function() {
    const err = res.getBody().error;
    const name = err.details.find(d => d.field === 'name');
    expect(name).to.be.an('object');
    expect(name.message).to.equal('name is required');
  });
}