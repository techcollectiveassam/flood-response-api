meta {
  name: Create affected area - missing latitude
  type: http
  seq: 14
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Dhemaji river bank",
    "location": {
      "source": "gps",
      "longitude": 91.8
    },
    "severity": "medium"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_location
}

tests {
  test("gps source without latitude is rejected", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'invalid_location');
    expect(err).to.have.property('message', 'latitude and longitude are required for gps source');
  });
}