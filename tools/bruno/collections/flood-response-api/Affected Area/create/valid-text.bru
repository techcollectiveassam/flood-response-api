meta {
  name: Create affected area - valid text
  type: http
  seq: 4
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Silchar water logging",
    "description": "Residents report water logging near the town stadium",
    "location": {
      "source": "text",
      "description": "Water logged near Silchar stadium"
    },
    "severity": "low"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("text source uses description and is unmatchable", function() {
    const data = res.getBody().data;
    const area = data.affected_area;
    expect(area).to.have.property('id');
    expect(area).to.have.property('name', 'Silchar water logging');
    expect(area).to.have.property('severity', 'low');
    expect(data).to.have.property('is_new_area', true);
    expect(data).to.have.property('match_reason', 'unmatchable');
  });
}