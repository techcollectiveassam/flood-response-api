meta {
  name: Create affected area - zero disaster_id
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": 0,
    "name": "Dhemaji river bank",
    "location": {
      "source": "gps",
      "latitude": 26.2,
      "longitude": 91.8
    },
    "severity": "medium"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_request_body
}

tests {
  test("zero disaster_id is treated as required validation error", function() {
    const err = res.getBody().error;
    const disaster = err.details.find(d => d.field === 'disaster_id');
    expect(disaster).to.be.an('object');
    expect(disaster.message).to.equal('disaster_id is required');
  });
}