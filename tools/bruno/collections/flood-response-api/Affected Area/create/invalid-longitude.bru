meta {
  name: Create affected area - invalid longitude
  type: http
  seq: 22
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Dhemaji river bank",
    "location": {
      "source": "gps",
      "latitude": 26.2,
      "longitude": "abc"
    },
    "severity": "medium"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_request_body
}

tests {
  test("non-numeric longitude is rejected", function() {
    const err = res.getBody().error;
    const longitude = err.details.find(d => d.field === 'location.longitude');
    expect(longitude).to.be.an('object');
    expect(longitude.message).to.equal('location.longitude must be a number');
  });
}