meta {
  name: Setup disaster for affected area get requests
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Affected Area Get Drill",
    "type": "flood"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("captures a disaster for the affected area fixture", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    bru.setEnvVar("disasterId", data.id);
  });
}
