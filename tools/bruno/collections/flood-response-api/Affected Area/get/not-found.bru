meta {
  name: Get an affected area - not found
  type: http
  seq: 4

}

get {
  url: {{baseUrl}}/api/v1/affected-areas/999999
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq affected_area_not_found
}

tests {
  test("unknown id returns a 404", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'affected_area_not_found');
    expect(err).to.have.property('message', 'affected area not found');
  });
}
