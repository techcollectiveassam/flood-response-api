meta {
  name: Get an individual affected area
  type: http
  seq: 3

}

get {
  url: {{baseUrl}}/api/v1/affected-areas/{{affectedAreaId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("returns the affected area details", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    expect(data).to.have.property('name');
    expect(data).to.have.property('disaster_id');
    expect(data).to.have.property('severity');
    expect(data).to.have.property('verification_status');
    expect(data).to.have.property('report_count');
  });

  test("the id matches the requested one", function() {
    const data = res.getBody().data;
    expect(String(data.id)).to.equal(String(bru.getEnvVar("affectedAreaId")));
  });

  test("severity and verification status use the documented enums", function() {
    const data = res.getBody().data;
    expect(['low', 'medium', 'high', 'critical']).to.include(data.severity);
    expect(['reported', 'investigating', 'verified', 'disputed', 'resolved']).to.include(data.verification_status);
  });
}
