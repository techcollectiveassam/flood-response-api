meta {
  name: Setup affected area for get requests
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/affected-areas
  body: json
  auth: none
}

body:json {
  {
    "disaster_ref_id": "{{disasterRefId}}",
    "description": "Low lying settlement along the Brahmaputra",
    "location": {
      "source": "gps",
      "name": "Guwahati riverine settlement",
      "latitude": 26.14,
      "longitude": 91.73
    },
    "severity": "high"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("captures an affected area for the get requests", function() {
    const data = res.getBody().data;
    expect(data.affected_area).to.have.property('ref_id');
    bru.setEnvVar("affectedAreaRefId", data.affected_area.ref_id);
  });
}
