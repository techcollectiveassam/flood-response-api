meta {
  name: List affected areas - limit exceeds max
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/affected-areas?limit=101
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_query_params
}

tests {
  test("a limit above the configured maximum is rejected", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'invalid_query_params');
    expect(err.message).to.match(/limit must not exceed \d+/);
  });
}
