meta {
  name: List all disasters
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/disasters
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("data is an array of disasters", function() {
    const data = res.getBody().data;
    expect(data).to.be.an('array');
    if (data.length > 0) {
      expect(data[0]).to.have.property('id');
      expect(data[0]).to.have.property('name');
      expect(data[0]).to.have.property('type');
      expect(data[0]).to.have.property('status');
    }
  });

  test("captures the first disaster id", function() {
    const data = res.getBody().data;
    if (data.length > 0) {
      bru.setEnvVar("disasterId", data[0].id);
    }
  });
}