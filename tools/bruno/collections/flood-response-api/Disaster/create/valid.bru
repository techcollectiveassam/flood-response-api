meta {
  name: Create disaster - valid
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Assam Flood",
    "description": "Situation on the ground",
    "type": "flood",
    "starts_at": "2026-09-17T00:00:00Z"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("create returns the created disaster", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    expect(data).to.have.property('name', 'Assam Flood');
    expect(data).to.have.property('description', 'Situation on the ground');
    expect(data).to.have.property('type', 'flood');
    expect(data).to.have.property('status', 'active');
    expect(data).to.have.property('starts_at', '2026-09-17T00:00:00Z');
  });

  test("captures the new disaster id", function() {
    const data = res.getBody().data;
    bru.setEnvVar("disasterId", data.id);
  });
}