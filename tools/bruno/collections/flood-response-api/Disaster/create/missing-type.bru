meta {
  name: Create disaster - missing type
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Landslide in Arunachal"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_request_body
}

tests {
  test("missing type is reported as validation error", function() {
    const err = res.getBody().error;
    const typeField = err.details.find(d => d.field === 'type');
    expect(typeField).to.be.an('object');
    expect(typeField.message).to.equal('type is required');
  });
}