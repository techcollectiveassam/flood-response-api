meta {
  name: Create disaster - valid minimal
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Guwahati Earthquake",
    "type": "earthquake"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("minimal request creates an active disaster", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    expect(data).to.have.property('name', 'Guwahati Earthquake');
    expect(data).to.have.property('type', 'earthquake');
    expect(data).to.have.property('status', 'active');
  });
}