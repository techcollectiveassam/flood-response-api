meta {
  name: Create command center - valid minimal
  type: http
  seq: 3
}

script:pre-request {
  const disasterId = bru.getEnvVar("disasterId");
  if (!disasterId) {
    bru.setEnvVar("disasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/command-centers
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{disasterId}},
    "name": "Volunteer Response Group",
    "type": "group"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("minimal request creates a command center", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    expect(data).to.have.property('disaster_id');
    expect(data).to.have.property('name', 'Volunteer Response Group');
    expect(data).to.have.property('type', 'group');
  });
}