meta {
  name: Create command center - valid
  type: http
  seq: 2
}

script:pre-request {
  const commandCenterDisasterId = bru.getEnvVar("commandCenterDisasterId");
  if (!commandCenterDisasterId) {
    bru.setEnvVar("commandCenterDisasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/command-centers
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{commandCenterDisasterId}},
    "name": "Assam State Disaster Management",
    "type": "government",
    "description": "State level coordination of flood response",
    "contact_person": "Anjali Sharma",
    "contact_mobile": "0000000000",
    "contact_email": "asdm@example.org"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("create returns the created command center", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    expect(data).to.have.property('disaster_id');
    expect(data).to.have.property('name', 'Assam State Disaster Management');
    expect(data).to.have.property('type', 'government');
    expect(data).to.have.property('description', 'State level coordination of flood response');
    expect(data).to.have.property('contact_person', 'Anjali Sharma');
    expect(data).to.have.property('contact_mobile', '0000000000');
    expect(data).to.have.property('contact_email', 'asdm@example.org');
  });

  test("captures the new command center id", function() {
    const data = res.getBody().data;
    bru.setEnvVar("commandCenterId", data.id);
  });
}