meta {
  name: Create command center - missing name
  type: http
  seq: 4
}

script:pre-request {
  const commandCenterDisasterId = bru.getEnvVar("commandCenterDisasterId");
  if (!commandCenterDisasterId) {
    bru.setEnvVar("commandCenterDisasterId", 1);
  }
}

post {
  url: {{baseUrl}}/api/v1/command-centers
  body: json
  auth: none
}

body:json {
  {
    "disaster_id": {{commandCenterDisasterId}},
    "type": "government"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq invalid_request_body
}

tests {
  test("missing name is reported as validation error", function() {
    const err = res.getBody().error;
    const name = err.details.find(d => d.field === 'name');
    expect(name).to.be.an('object');
    expect(name.message).to.equal('name is required');
  });
}