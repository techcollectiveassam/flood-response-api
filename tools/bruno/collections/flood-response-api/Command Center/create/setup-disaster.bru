meta {
  name: Setup disaster for command center
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Command Center Coordination Drill",
    "type": "flood"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("captures a disaster for command center requests", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    bru.setEnvVar("commandCenterDisasterId", data.id);
  });
}