meta {
  name: Get a command center - disaster has none
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/disasters/{{disasterWithoutCommandCenterId}}/command-center
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body: isJson
  res.body.error: isJson
  res.body.error.code: eq command_center_not_found
}

tests {
  test("a disaster without a command center returns a 404", function() {
    const err = res.getBody().error;
    expect(err).to.have.property('code', 'command_center_not_found');
    expect(err).to.have.property('message', 'command center not found');
  });

  test("the 404 is about the command center, not a missing disaster", function() {
    expect(res.getBody().error.code).to.not.equal('disaster_not_found');
  });
}
