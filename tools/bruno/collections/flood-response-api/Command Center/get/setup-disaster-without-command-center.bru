meta {
  name: Setup disaster without a command center
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/disasters
  body: json
  auth: none
}

body:json {
  {
    "name": "Command Center Drill Without A Center",
    "type": "flood"
  }
}

assert {
  res.status: eq 201
  res.body: isJson
  res.body.data: isJson
}

tests {
  test("captures a disaster that has no command center", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('id');
    bru.setEnvVar("disasterWithoutCommandCenterId", data.id);
  });
}
